{
  "name": "vapour-engine",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "A WebGPU-first 2D, 3D, and XR game engine for the browser.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:wasm && pnpm -r build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:sdk": "bash scripts/build-sdk-release.sh",
    "check": "pnpm build:types && node scripts/generate-manifest.mjs --check && pnpm -r check",
    "dev": "pnpm --filter @vapour/editor dev",
    "test": "pnpm build:types && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vapour": "pnpm --filter @vapour/cli start",
    "manifest": "node scripts/generate-manifest.mjs",
    "build:types": "node scripts/build-types.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "license": "LGPL-3.0-or-later"
}
