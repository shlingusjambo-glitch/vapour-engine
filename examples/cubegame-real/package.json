{
  "name": "cubegame",
  "version": "1.0.0",
  "description": "CubeGame voxel survival sandbox with CrownForge multiplayer, desktop hosts, procedural assets, and worker meshing.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:web",
    "build:web": "tsc && vite build",
    "platform:doctor": "node scripts/build-platforms.mjs doctor",
    "build:desktop": "node scripts/build-platforms.mjs desktop",
    "build:mac": "node scripts/build-platforms.mjs mac",
    "build:linux": "node scripts/build-platforms.mjs linux",
    "build:windows": "node scripts/build-platforms.mjs windows",
    "build:ios": "node scripts/build-platforms.mjs ios",
    "build:platforms": "node scripts/build-platforms.mjs all",
    "preview": "vite preview",
    "server": "ts-node -O '{\"module\": \"commonjs\"}' server/server.ts",
    "start": "concurrently \"pnpm run dev\" \"pnpm run server\"",
    "desktop:electron": "pnpm run build:web && electron electron/main.cjs",
    "package:electron": "pnpm run build:web && electron-builder",
    "package:electron:mac": "pnpm run build:web && electron-builder --mac dir --config.directories.output=build/mac",
    "package:electron:linux": "pnpm run build:web && electron-builder --linux dir --x64 --config.directories.output=build/linux",
    "package:electron:windows": "pnpm run build:web && electron-builder --win dir --x64 --config.directories.output=build/windows"
  },
  "dependencies": {
    "@vapour/engine": "workspace:*",
    "@vapour/three-bridge": "workspace:*",
    "localtunnel": "^2.0.2",
    "three": "^0.152.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/three": "^0.152.1",
    "@types/ws": "^8.5.5",
    "concurrently": "^8.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^24.13.3",
    "express": "^4.18.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "vite": "^6.4.3",
    "@types/node": "^20.11.30"
  },
  "build": {
    "appId": "com.snowstudios.cubegame",
    "productName": "CubeGame",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "mods/**/*",
      "public/mods/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dir",
        "zip"
      ],
      "hardenedRuntime": false
    },
    "linux": {
      "category": "Game",
      "target": [
        "dir",
        "tar.gz"
      ]
    },
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    },
    "asar": true,
    "directories": {
      "output": "build/electron"
    }
  },
  "allowScripts": {
    "electron-builder@24.13.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "axios": "^1.7.4",
    "esbuild": "^0.28.1",
    "tar": "^7.5.16"
  }
}
