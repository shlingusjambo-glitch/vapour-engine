NODE_ENV=production
PORT=8080
BIND_ADDR=0.0.0.0

# Public URLs shown by the server browser and shared with clients.
PUBLIC_SERVER_URL=https://play.your-domain.com
PUBLIC_WS_URL=wss://play.your-domain.com
PUBLIC_SERVER_REGION=global
PUBLIC_SERVER_PROVIDER=production

# Comma-separated browser origins allowed to call the HTTP API in production.
CUBEGAME_CORS_ORIGINS=https://play.your-domain.com
CUBEGAME_TRUST_PROXY=1

# Keep temporary LocalTunnel sharing disabled for public production servers.
CUBEGAME_ENABLE_PUBLIC_TUNNEL=0

# Set a long random value or use Admin/Owner accounts for admin routes.
ADMIN_SECRET=

# Optional release controls.
CUBEGAME_REQUIRE_AUTH=0
CUBEGAME_MAX_STORED_SKINS=128
CUBEGAME_MAX_SKIN_BYTES=262144
CUBEGAME_WS_HEARTBEAT_MS=30000
CROWNFORGE_MIN_PLAYERS=2
