{
  "name": "@vapour/example-open-world",
  "version": "0.2.5-alpha",
  "type": "module",
  "private": true,
  "description": "Mirage showcase: procedural terrain, vegetation, streaming, floating origin, and navigation composed from engine systems",
  "scripts": {
    "build": "tsc -p tsconfig.json",
