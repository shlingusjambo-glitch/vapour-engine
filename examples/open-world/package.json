  },
  "dependencies": {
    "@vapour/engine": "workspace:*",
    "@vapour/math": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "LGPL-3.0-or-later"
}
