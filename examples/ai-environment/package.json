{
  "name": "@vapour/example-ai-environment",
  "version": "0.2.5-alpha",
  "type": "module",
  "private": true,
  "description": "Generates a complete environment \u2014 terrain, a street of houses, vegetation, and NPCs \u2014 from a structured description",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "tsc -p tsconfig.json && node dist/generate.js"
  },
  "dependencies": {
    "@vapour/assetgen": "workspace:*",
    "@vapour/math": "workspace:*",
    "@vapour/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.2"
  },
  "license": "LGPL-3.0-or-later"
}
